# Static public pages run without credentials; the portfolio needs Neon.
# Copy to .env.local for database, administration and image uploads. Preserve an existing file.
# Leave unused values empty. Do not put secrets in NEXT_PUBLIC_* variables.

# Neon PostgreSQL: pooled runtime connection and direct migration connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js: one administrator, encrypted JWT sessions, no registration.
# Generate at least 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Canonical origin: local here, https://bitmasonlabs.com in production.
# For Vercel previews, omit AUTH_URL to use platform inference.
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
# Run npm run admin:password; paste the scrypt hash, never the plaintext password.
ADMIN_PASSWORD_HASH=

# Cloudflare R2: use credentials scoped to the intended bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Required public origin for uploads: https://assets.bitmasonlabs.com
# Never expose the private S3 endpoint.
R2_PUBLIC_BASE_URL=

# Leave false until the production domain, content and launch checks pass.
# This is a server-side build setting. Preview/admin/API routes stay unindexed.
SITE_INDEXING_ENABLED=false
