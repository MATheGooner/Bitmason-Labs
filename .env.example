# The foundation runs without an environment file.
# Copy to .env.local only when configuring a future integration.
# Leave unused values empty. Do not put secrets in NEXT_PUBLIC_* variables.

# Neon PostgreSQL: pooled runtime connection and direct migration connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js: choose providers and a session strategy before adding credentials.
# Generate a unique AUTH_SECRET when authentication is actually implemented.
AUTH_SECRET=
AUTH_URL=

# Cloudflare R2: use credentials scoped to the intended bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional HTTPS custom asset domain. Never expose the private S3 endpoint.
R2_PUBLIC_BASE_URL=

# Vercel and Cloudflare DNS need no application credentials for this batch.
